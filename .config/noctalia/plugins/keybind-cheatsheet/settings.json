        {
          "keys": "Mute",
          "desc": "Mute output",
          "_verb": "exec",
          "_param": "$ipc volume muteOutput",
          "_mods": "",
          "_mainKey": "XF86AUDIOMUTE"
        },
        {
          "keys": "Mic Mute",
          "desc": "Mute mic",
          "_verb": "exec",
          "_param": "$ipc volume muteInput",
          "_mods": "",
          "_mainKey": "XF86AUDIOMICMUTE"
        },
        {
          "keys": "XF86AUDIOPLAYPAUSE",
          "desc": "Play/pause",
          "_verb": "exec",
          "_param": "$ipc media playPause",
          "_mods": "",
          "_mainKey": "XF86AUDIOPLAYPAUSE"
        },
        {
          "keys": "Play",
          "desc": "Play",
          "_verb": "exec",
          "_param": "$ipc media play",
          "_mods": "",
          "_mainKey": "XF86AUDIOPLAY"
        },
        {
          "keys": "Pause",
          "desc": "Pause",
          "_verb": "exec",
          "_param": "$ipc media pause",
          "_mods": "",
          "_mainKey": "XF86AUDIOPAUSE"
        },
        {
          "keys": "Next",
          "desc": "Next track",
          "_verb": "exec",
          "_param": "$ipc media next",
          "_mods": "",
          "_mainKey": "XF86AUDIONEXT"
        },
        {
          "keys": "Prev",
          "desc": "Prev track",
          "_verb": "exec",
          "_param": "playerctl previous",
          "_mods": "",
          "_mainKey": "XF86AUDIOPREV"
        },
        {
          "keys": "PAUSE",
          "desc": "Pause (Pause key)",
          "_verb": "exec",
          "_param": "$ipc media pause",
          "_mods": "",
          "_mainKey": "PAUSE"
        },
        {
          "keys": "Calc",
          "desc": "Calculator",
          "_verb": "exec",
          "_param": "gnome-calculator",
          "_mods": "",
          "_mainKey": "XF86CALCULATOR"
        }
      ]
    },
    {
      "title": "BRIGHTNESS",
      "binds": [
        {
          "keys": "Bright Up",
          "desc": "Brightness up",
          "_verb": "exec",
          "_param": "$ipc brightness increase",
          "_mods": "",
          "_mainKey": "XF86MONBRIGHTNESSUP"
        },
        {
          "keys": "Bright Down",
          "desc": "Brightness down",
          "_verb": "exec",
          "_param": "$ipc brightness decrease",
          "_mods": "",
          "_mainKey": "XF86MONBRIGHTNESSDOWN"
        },
        {
          "keys": "PgUp",
          "desc": "Brightness up (PgUp)",
          "_verb": "exec",
          "_param": "$ipc brightness increase",
          "_mods": "",
          "_mainKey": "PRIOR"
        },
        {
          "keys": "PgDn",
          "desc": "Brightness down (PgDn)",
          "_verb": "exec",
          "_param": "$ipc brightness decrease",
          "_mods": "",
          "_mainKey": "NEXT"
        }
      ]
    },
    {
      "title": "SCREENSHOTS & RECORDING",
      "binds": [
        {
          "keys": "PrtSc",
          "desc": "Screenshot (full)",
          "_verb": "exec",
          "_param": "$HYPR_SCRIPTS/screenshot",
          "_mods": "",
          "_mainKey": "PRINT"
        },
        {
          "keys": "Shift + PrtSc",
          "desc": "Screenshot (region)",
          "_verb": "exec",
          "_param": "$HYPR_SCRIPTS/screenshot --select",
          "_mods": "Shift",
          "_mainKey": "PRINT"
        },
        {
          "keys": "Ctrl + PrtSc",
          "desc": "Record screen",
          "_verb": "exec",
          "_param": "$HYPR_SCRIPTS/toggle_recording",
          "_mods": "Ctrl",
          "_mainKey": "PRINT"
        },
        {
          "keys": "Shift + Ctrl + PrtSc",
          "desc": "Record region",
          "_verb": "exec",
          "_param": "$HYPR_SCRIPTS/toggle_recording --select",
          "_mods": "Shift+Ctrl",
          "_mainKey": "PRINT"
        }
      ]
    },
    {
      "title": "MOUSE",
      "binds": [
        {
          "keys": "Super + Left Click",
          "desc": "Move window",
          "_verb": "movewindow",
          "_param": "",
          "_mods": "Super",
          "_mainKey": "MOUSE:272"
        },
        {
          "keys": "Super + Right Click",
          "desc": "Resize window",
          "_verb": "resizewindow",
          "_param": "",
          "_mods": "Super",
          "_mainKey": "MOUSE:273"
        }
      ]
    }
  ],
  "detectedCompositor": "hyprland",
  "windowWidth": 1500,
  "windowHeight": 850,
  "autoHeight": false,
  "columnCount": 3,
  "modKeyVariable": "$mainMod",
  "hyprlandConfigPath": "~/.config/hypr/configs/binds.conf",
  "hyprlandLuaConfigPath": "~/.config/hypr/hyprland.lua",
  "hyprlandParserMode": "auto",
  "niriConfigPath": "~/.config/niri/config.kdl",
  "mangoConfigPath": "~/.config/mango/config.conf",
  "mergeSequentialBinds": true,
  "showUndescribedBinds": true,
  "splitLargeWorkspaceCategory": true,
  "workspaceSplitThreshold": 12,
  "keyColorAlt": "#FF6B6B",
  "keyColorXF86": "#4ECDC4",
  "keyColorPrint": "#95E1D3",
  "keyColorNumeric": "#A8DADC",
  "keyColorMouse": "#F38181",
  "keyColorSuper": "#ffffff",
  "keyColorCtrl": "",
  "keyColorShift": "#40e2e2",
  "keyColorDefault": "#6C757D",
  "keyLabelColor": "#FFFFFF",
  "keyTextSuper": "#131313",
  "keyTextCtrl": "#131313",
  "keyTextShift": "#131313",
  "keyTextAlt": "#131313",
  "keyTextXF86": "#131313",
  "keyTextPrint": "#131313",
  "keyTextNumeric": "#131313",
  "keyTextMouse": "#131313",
  "keyTextDefault": "#131313",
  "descriptionTextColor": "#ffffff",
  "bindOverrides": {}
}
