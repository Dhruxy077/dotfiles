shell /usr/bin/fish
include colors/tokyonight.conf
# --- Fonts ---
# You can change 'JetBrains Mono' to any font installed on your system
font_family      JetBrains Mono NerdFont
# bold_font        auto
# italic_font      auto
# bold_italic_font auto
# font_size        14

# cursor trail for the animation

cursor_shape block
cursor_shape_unfocused hollow
cursor_blink_interval 0.5
cursor_stop_blinking_after 15.0


notify_on_cmd_finish invisible 20
#: Scrollback
scrollback_lines 10000

#: Mouse
url_style dotted
copy_on_select yes
open_url_modifiers cmd
cursor_shape block
cursor_trail 200
cursor_trail_decay 0.1 0.4
cursor_trail_start_threshold 2
mouse_hide_wait -3.0

mouse_map button-name event-type modes action

mouse_map middle release ungrabbed paste_from_selection
tab_bar_style powerline
tab_powerline_style round

# --- Window Layout ---
# Adds a nice breathing room around the text
window_padding_width 8
# Hides the default Linux title bar for a cleaner look
hide_window_decorations yes

# --- Transparency ---
# 1.0 is solid, 0.0 is completely clear (requires a compositor like Picom or Wayland)
background_opacity 0.9
# background_blur 1
# --- Annoyance Fixes ---
# Turns off that loud "ding" noise when you hit backspace too many times
enable_audio_bell no
